@page "/editor"
@inject IJSRuntime JS
@inject HttpClient Http
@using ev.Models
@using System.Text.Json

<MudText Typo="Typo.h5" Class="mb-4">Editor</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudSelect T="string" Label="Editing Book" Value="_dataFile" ValueChanged="OnBookChanged"
               Variant="Variant.Outlined" Style="max-width:300px;">
        @foreach (var book in Books)
        {
            <MudSelectItem Value="@book.File">@book.Title</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    @if (_data.Chapters.Any())
    {
        var chapters = _data.Chapters.OrderBy(c => c.Page).ToList();
        <MudSlider T="int" Min="1" Max="@(chapters.Count + 1)" Step="1"
                   @bind-Value="_chapterIndex"
                   Color="Color.Primary"
                   TickMarks="true" />
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Primary">No chapters loaded yet.</MudText>
    }
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Elevation="2" Class="pa-4" Style="height:100%;">

            <MudText Typo="Typo.h6" Class="mb-2">Book Settings</MudText>
            <MudNumericField T="int" Label="Total Pages" @bind-Value="_data.TotalPages"
                             Variant="Variant.Outlined" Class="mb-4"
                             OnBlur="RefreshJson" />

            <MudDivider Class="mb-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Add Character</MudText>
            <MudTextField @bind-Value="_newCharName" Label="Name"
                          Variant="Variant.Outlined" Class="mb-2" />
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText>Color</MudText>
                <input type="color" @bind="_newCharColor"
                       style="width:40px; height:36px; border:none; cursor:pointer;" />
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       FullWidth="true" OnClick="AddCharacter"
                       Disabled="@(string.IsNullOrWhiteSpace(_newCharName))">
                Add Character
            </MudButton>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Add Chapter</MudText>
            <MudTextField @bind-Value="_newChapterName" Label="Chapter Name"
                          Variant="Variant.Outlined" Class="mb-2" />
            <MudNumericField T="double" Label="Starting Page" @bind-Value="_newChapterPage"
                             Variant="Variant.Outlined" Class="mb-2" Min="0.1" />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                       FullWidth="true" OnClick="AddChapter"
                       Disabled="@(string.IsNullOrWhiteSpace(_newChapterName))">
                Add Chapter
            </MudButton>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Current Chapter</MudText>
            <MudSelect T="int" @bind-Value="_chapterIndex" Variant="Variant.Outlined" Class="mb-2">
                @foreach (var chapter in _data.Chapters.OrderBy(c => c.Page))
                {
                    var index = _data.Chapters.OrderBy(c => c.Page).ToList().IndexOf(chapter) + 1;
                    <MudSelectItem T="int" Value="@index">@chapter.Name</MudSelectItem>
                }
                <MudSelectItem T="int" Value="@(_data.Chapters.Count + 1)">End</MudSelectItem>
            </MudSelect>

            <MudDivider Class="my-4" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudPaper Elevation="2" Class="pa-4" Style="height:100%;">
            <MudText Typo="Typo.h6" Class="mb-2">Location Presets</MudText>
            <MudTextField @bind-Value="_newPresetName" Label="Location Name"
                          Variant="Variant.Outlined" Class="mb-2" />
            @if (_pendingPresetX.HasValue)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Pin placed at @($"{_pendingPresetX:F1}")%, @($"{_pendingPresetY:F1}")%
                </MudAlert>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Warning"
                       FullWidth="true" Class="mb-2"
                       OnClick="() => _placingPreset = !_placingPreset">
                @(_placingPreset ? "✓ Preset Mode ON" : "📍 Enter Preset Mode")
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning"
                       FullWidth="true" OnClick="AddPreset"
                       Disabled="@(!CanAddPreset)">
                Save Preset
            </MudButton>

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Move Preset</MudText>
            @if (_movingPreset == null)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Click a ⭐ on the map to select it for moving.</MudText>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-2">
                    Moving: <strong>@_movingPreset.Name</strong> — now click the map to place it.
                </MudAlert>
                <MudButton Variant="Variant.Outlined" Color="Color.Default"
                           FullWidth="true" OnClick="() => _movingPreset = null">
                    Cancel
                </MudButton>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" Class="mb-2">Place Entry</MudText>

            <MudSelect T="string" Label="Load Preset" Value="_selectedPresetId"
                       ValueChanged="OnPresetSelected"
                       Variant="Variant.Outlined" Class="mb-2"
                       Clearable="true">
                @foreach (var p in _data.Locations)
                {
                    <MudSelectItem Value="@p.Id">@p.Name</MudSelectItem>
                }
            </MudSelect>

            <MudAutocomplete T="string" Label="Character"
                             @bind-Value="_formCharacterId"
                             SearchFunc="SearchCharacters"
                             ToStringFunc="@(id => _data.Characters.FirstOrDefault(c => c.Id == id)?.Name ?? "")"
                             Variant="Variant.Outlined" Class="mb-2"
                             ResetValueOnEmptyText="false"
                             CoerceText="false" />

            <MudNumericField T="double" Label="Page Number" @bind-Value="_formPage"
                             Variant="Variant.Outlined" Class="mb-2" Min="0.1" />
            <MudTextField @bind-Value="_formLocation" Label="Location"
                          Variant="Variant.Outlined" Class="mb-2" />
            <MudTextField @bind-Value="_formNote" Label="Note (optional)"
                          Variant="Variant.Outlined" Class="mb-2" />
            <MudCheckBox T="bool" @bind-Value="_formIsInvisible" Class="mb-2"
                         Label="Invisible marker (curve helper)" />

            @if (_pendingX.HasValue)
            {
                <MudAlert Severity="Severity.Success" Class="mb-2">
                    Pin placed at @($"{_pendingX:F1}")%, @($"{_pendingY:F1}")%
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Class="mb-2">
                    Click the map to place a pin
                </MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Success"
                       FullWidth="true" OnClick="AddEntry"
                       Disabled="@(!CanAddEntry)">
                Add Entry
            </MudButton>

            @if (_selectedEntry != null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                           FullWidth="true" Class="mt-2"
                           StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="DeleteSelected">
                    Delete Selected Marker
                </MudButton>
                <MudText Typo="Typo.caption" Class="mt-1">
                    Selected: @(_data.Characters.FirstOrDefault(c => c.Id == _selectedEntry.CharacterId)?.Name) — @_selectedEntry.Location (p.@_selectedEntry.Page)
                    @if (_selectedEntry.IsInvisible)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">invisible</MudChip>
                    }
                </MudText>
            }

        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 px-2">
                <MudText Typo="Typo.caption" Color="Color.Primary">
                    @(_placingPreset ? "🟡 Preset mode — click to place preset pin" : "Scroll to zoom · Drag to pan · Click to place pin")
                </MudText>
                <MudSpacer />
                <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" OnClick="ZoomIn" />
                <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" OnClick="ZoomOut" />
                <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" OnClick="ResetZoom" />
            </MudStack>

            <div id="editor-map" style="overflow: hidden; width: 100%; touch-action: none;">
                <div id="editor-map-inner" style="position: relative; display: inline-block; width: 100%; cursor: none;"
                     @onclick="HandleMapClick"
                     @onmousemove="HandleMouseMove"
                     @onmouseleave="() => { _cursorX = null; _cursorY = null; }">

                    <img src="Images/Maps/inheritance_original_map.jpg"
                         style="width:100%; height:auto; display:block;" alt="Map" />

                    <svg style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none;">
                        @foreach (var character in _data.Characters)
                        {
                            var ordered = FilteredEntries
                            .Where(e => e.CharacterId == character.Id)
                            .OrderBy(e => e.Progress).ToList();
                            for (int i = 0; i < ordered.Count - 1; i++)
                            {
                                var a = ordered[i]; var b = ordered[i + 1];
                                <line x1="@($"{a.X:F2}%")" y1="@($"{a.Y:F2}%")"
                                      x2="@($"{b.X:F2}%")" y2="@($"{b.Y:F2}%")"
                                      stroke="@character.Color" stroke-width="1"
                                      stroke-dasharray="4 3" stroke-opacity="0.4" />
                            }
                        }
                        @if (_cursorX.HasValue)
                        {
                            <line x1="@($"{_cursorX:F2}%")" y1="0%"
                                  x2="@($"{_cursorX:F2}%")" y2="100%"
                                  stroke="red" stroke-width="0.5" stroke-opacity="0.8" />
                            <line x1="0%" y1="@($"{_cursorY:F2}%")"
                                  x2="100%" y2="@($"{_cursorY:F2}%")"
                                  stroke="red" stroke-width="0.5" stroke-opacity="0.8" />
                            <circle cx="@($"{_cursorX:F2}%")" cy="@($"{_cursorY:F2}%")"
                                    r="3" fill="none" stroke="red" stroke-width="1" stroke-opacity="0.9" />
                        }
                    </svg>

                    @foreach (var entry in FilteredEntries)
                    {
                        var character = _data.Characters.FirstOrDefault(c => c.Id == entry.CharacterId);
                        if (character == null) continue;
                        if (!entry.IsInvisible && _data.Locations.Any(p => Math.Abs(p.X - entry.X) < 0.01 && Math.Abs(p.Y - entry.Y) < 0.01)) continue;
                        var capturedEntry = entry;
                        var isSelected = _selectedEntry == entry;
                        @if (entry.IsInvisible)
                        {
                            <MudTooltip Text="@($"{character.Name} — {entry.Location} (p.{entry.Page}) [invisible]")">
                                <MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked"
                                               Style="@($"position:absolute; left:{entry.X:F2}%; top:{entry.Y:F2}%; transform:translate(-50%,-50%); padding:0; color:{character.Color}; opacity:{(isSelected ? "1.0" : "0.5")};")"
                                               OnClick="@((e) => SelectEntry(capturedEntry))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@($"{character.Name} — {entry.Location} (p.{entry.Page})")">
                                <MudIconButton Icon="@Icons.Material.Filled.Place"
                                               Style="@($"position:absolute; left:{entry.X:F2}%; top:{entry.Y:F2}%; transform:translate(-50%,-100%); padding:0; color:{character.Color}; opacity:{(isSelected ? "1.0" : "0.75")};")"
                                               OnClick="@((e) => SelectEntry(capturedEntry))" />
                            </MudTooltip>
                        }
                    }

                    @foreach (var preset in _data.Locations)
                    {
                        var capturedPreset = preset;
                        var isMoving = _movingPreset == preset;
                        var tooltipText = isMoving ? $"✋ Moving: {preset.Name}" : $"📍 {preset.Name} (click to move)";
                        <MudTooltip Text="@tooltipText">
                            <MudIconButton Icon="@(isMoving? Icons.Material.Filled.Circle : Icons.Material.Outlined.Circle)"
                                           Style="@($"position:absolute; left:{preset.X:F2}%; top:{preset.Y:F2}%; transform:translate(-50%,-50%); padding:0; color:{(isMoving ? "#f97316" : "#f59e0b")}; opacity:{(isMoving ? "1.0" : "0.8")}; filter:{(isMoving ? "drop-shadow(0 0 4px white)" : "none")};")"
                                           OnClick="@((e) => SelectPresetForMove(capturedPreset))" />
                        </MudTooltip>
                    }

                    @if (_pendingX.HasValue)
                    {
                        <MudIcon Icon="@(_formIsInvisible? Icons.Material.Filled.RadioButtonUnchecked : Icons.Material.Filled.AddLocation)"
                                 Style="@($"position:absolute; left:{_pendingX:F2}%; top:{_pendingY:F2}%; transform:translate(-50%,-100%); color:#f59e0b; pointer-events:none; font-size:2rem;")" />
                    }

                    @if (_pendingPresetX.HasValue)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star"
                                 Style="@($"position:absolute; left:{_pendingPresetX:F2}%; top:{_pendingPresetY:F2}%; transform:translate(-50%,-50%); color:#f59e0b; pointer-events:none; font-size:2rem;")" />
                    }
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudText Typo="Typo.h6" Class="mb-2">Characters & Presets</MudText>
    <div style="overflow-x:auto;">
        <MudTable Items="CharacterAndPresetRows" Dense="true" Hover="true" Striped="true" T="TableRow"
                  SortLabel="Sort By">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Type)">Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Label)">Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.X)">X</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Y)">Y</MudTableSortLabel></MudTh>
                <MudTh>Color</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @if (context.Type == "Character")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Character</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Preset</MudChip>
                    }
                </MudTd>
                <MudTd>@context.Label</MudTd>
                <MudTd>@(context.X.HasValue ? $"{context.X:F1}" : "—")</MudTd>
                <MudTd>@(context.Y.HasValue ? $"{context.Y:F1}" : "—")</MudTd>
                <MudTd>
                    @if (context.Source is CharacterModel cm)
                    {
                        var captured = cm;
                        <input type="color" value="@cm.Color"
                               style="width:28px; height:28px; border:none; cursor:pointer; border-radius:4px;"
                               @onchange="e => UpdateCharacterColor(captured, e.Value?.ToString() ?? captured.Color)" />
                    }
                    else
                    {
                        <span>—</span>
                    }
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteRow(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6" Style="flex:1">Entries & Chapters (@FilteredEntryAndChapterRows.Count)</MudText>
        <MudSwitch T="bool" @bind-Value="_hideChapterRows" Color="Color.Primary" Label="Hide Chapters" />
    </MudStack>
    <div style="overflow-x:auto;">
        <MudTable Items="DisplayedEntryAndChapterRows" Dense="true" Hover="true" Striped="true" T="TableRow"
                  SortLabel="Sort By">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Type)">Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Character)">Character</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Page)" InitialDirection="SortDirection.Ascending">Page</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Progress)">Progress</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Label)">Location / Chapter</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.X)">X</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Y)">Y</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Note)">Note</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<TableRow, object>(r => r.Invisible)">Invisible</MudTableSortLabel></MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @if (context.Type == "Chapter")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Chapter</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary">Entry</MudChip>
                    }
                </MudTd>
                <MudTd>@context.Character</MudTd>
                <MudTd>@(context.Page > 0 ? context.Page.ToString() : "—")</MudTd>
                <MudTd>@(context.Progress > 0 ? $"{context.Progress:P1}" : "—")</MudTd>
                <MudTd>@context.Label</MudTd>
                <MudTd>@(context.X.HasValue ? $"{context.X:F1}" : "—")</MudTd>
                <MudTd>@(context.Y.HasValue ? $"{context.Y:F1}" : "—")</MudTd>
                <MudTd>@context.Note</MudTd>
                <MudTd>@(context.Invisible ? "✓" : "")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" Color="Color.Error"
                                   OnClick="() => DeleteRow(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </div>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4 mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h6" Style="flex:1">JSON Output</MudText>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CopyJson">Copy</MudButton>
    </MudStack>
    <MudTextField Value="@_json" Variant="Variant.Outlined" Lines="12" ReadOnly="true" />
</MudPaper>

@code {
    // *** Add new books here ***
    private record BookEntry(string Title, string File);
    private static readonly List<BookEntry> Books = new()
    {
        new("Eragon",       "data/eragonMapData.json"),
        new("Eldest",       "data/eldestMapData.json"),
        new("Brisingr",     "data/brisingrMapData.json"),
        new("Inheritance",  "data/inheritanceMapData.json"),
    };

    private string _dataFile = "data/eragonMapData.json";

    private MapEntry? _selectedEntry;
    private MapData _data = new();
    private string _json = "";
    private int _chapterIndex = 1;
    private bool _hideChapterRows = true;

    private string _newCharName = "";
    private string _newCharColor = "#3b82f6";
    private string _newChapterName = "";
    private double _newChapterPage = 1;

    private string _newPresetName = "";
    private double? _pendingPresetX;
    private double? _pendingPresetY;
    private bool _placingPreset = false;
    private LocationPreset? _movingPreset = null;
    private string _selectedPresetId = "";

    private string _formCharacterId = "";
    private double _formPage = 1;
    private string _formLocation = "";
    private string _formNote = "";
    private bool _formIsInvisible = false;
    private double? _pendingX;
    private double? _pendingY;
    private double? _cursorX;
    private double? _cursorY;

    private Task<IEnumerable<string>> SearchCharacters(string search, CancellationToken ct)
    {
        var results = _data.Characters
            .OrderBy(c => c.Name)
            .Where(c => string.IsNullOrWhiteSpace(search) || c.Name.Contains(search, StringComparison.OrdinalIgnoreCase))
            .Select(c => c.Id);
        return Task.FromResult(results);
    }

    private bool IsEnd => _chapterIndex > _data.Chapters.Count;

    private ChapterModel? SelectedChapter =>
        _data.Chapters.Any()
            ? _data.Chapters.OrderBy(c => c.Page).ElementAtOrDefault(_chapterIndex - 1)
            : null;

    private List<MapEntry> FilteredEntries =>
        _data.Entries
            .Where(e => !_data.Chapters.Any() || IsEnd || e.Page < SelectedChapter!.Page)
            .ToList();

    private bool CanAddEntry =>
        !string.IsNullOrWhiteSpace(_formCharacterId) &&
        !string.IsNullOrWhiteSpace(_formLocation) &&
        _pendingX.HasValue;

    private bool CanAddPreset =>
        !string.IsNullOrWhiteSpace(_newPresetName) &&
        _pendingPresetX.HasValue;

    private record TableRow(
        string Type, string Character, double Page, double Progress,
        string Label, double? X, double? Y, string Note, bool Invisible, object Source);

    private List<TableRow> CharacterAndPresetRows =>
        _data.Characters.Select(c => new TableRow(
            Type: "Character", Character: "", Page: 0, Progress: 0,
            Label: c.Name, X: null, Y: null, Note: "", Invisible: false, Source: c))
        .Concat(_data.Locations.Select(p => new TableRow(
            Type: "Preset", Character: "", Page: 0, Progress: 0,
            Label: p.Name, X: p.X, Y: p.Y, Note: "", Invisible: false, Source: p)))
        .ToList();

    private List<TableRow> FilteredEntryAndChapterRows =>
        FilteredEntries.Select(e => new TableRow(
            Type: "Entry",
            Character: _data.Characters.FirstOrDefault(c => c.Id == e.CharacterId)?.Name ?? "?",
            Page: e.Page, Progress: e.Progress, Label: e.Location,
            X: e.X, Y: e.Y, Note: e.Note, Invisible: e.IsInvisible, Source: e))
        .Concat(_data.Chapters
            .Where(ch =>
            {
                var ordered = _data.Chapters.OrderBy(c => c.Page).ToList();
                return ordered.IndexOf(ch) < _chapterIndex;
            })
            .Select(ch => new TableRow(
                Type: "Chapter", Character: "", Page: ch.Page,
                Progress: ch.GetProgress(_data.TotalPages), Label: ch.Name,
                X: null, Y: null, Note: "", Invisible: false, Source: ch)))
        .ToList();

    private List<TableRow> DisplayedEntryAndChapterRows =>
        _hideChapterRows
            ? FilteredEntryAndChapterRows.Where(r => r.Type != "Chapter").ToList()
            : FilteredEntryAndChapterRows;

    private async Task OnBookChanged(string file)
    {
        _dataFile = file;
        _chapterIndex = 1;
        _selectedEntry = null;
        _pendingX = null;
        _pendingY = null;
        _pendingPresetX = null;
        _pendingPresetY = null;
        _placingPreset = false;
        _movingPreset = null;
        _selectedPresetId = "";
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<MapData>($"{_dataFile}?v={DateTime.UtcNow.Ticks}") ?? new();
        }
        catch { _data = new(); }
        RefreshJson();
        StateHasChanged();
    }

    private void DeleteRow(TableRow row)
    {
        if (row.Source is MapEntry entry)
        {
            _data.Entries.Remove(entry);
            if (_selectedEntry == entry) _selectedEntry = null;
        }
        else if (row.Source is ChapterModel chapter)
            _data.Chapters.Remove(chapter);
        else if (row.Source is LocationPreset preset)
            _data.Locations.Remove(preset);
        else if (row.Source is CharacterModel character)
        {
            _data.Characters.Remove(character);
            _data.Entries.RemoveAll(e => e.CharacterId == character.Id);
        }
        RefreshJson();
        StateHasChanged();
    }

    private void SelectPresetForMove(LocationPreset preset)
    {
        _movingPreset = _movingPreset == preset ? null : preset;
        _placingPreset = false;
    }

    private void OnPresetSelected(string presetId)
    {
        _selectedPresetId = presetId;
        var preset = _data.Locations.FirstOrDefault(p => p.Id == presetId);
        if (preset != null)
        {
            _formLocation = preset.Name;
            _pendingX = preset.X;
            _pendingY = preset.Y;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("mapHelper.initPanzoom", "editor-map", "editor-map-inner");
    }

    private async Task ResetZoom() =>
        await JS.InvokeVoidAsync("mapHelper.resetZoom", "editor-map");

    private async Task ZoomIn() =>
        await JS.InvokeVoidAsync("eval", "mapHelper.panzoomInstances['editor-map']?.instance.zoomIn()");

    private async Task ZoomOut() =>
        await JS.InvokeVoidAsync("eval", "mapHelper.panzoomInstances['editor-map']?.instance.zoomOut()");

    private async Task HandleMouseMove(MouseEventArgs e)
    {
        var result = await JS.InvokeAsync<ClickResult>(
            "mapHelper.getClickPercentage",
            await JS.InvokeAsync<IJSObjectReference>("eval", "document.getElementById('editor-map-inner')"),
            e.ClientX, e.ClientY);
        _cursorX = result.X;
        _cursorY = result.Y;
    }

    private async Task HandleMapClick(MouseEventArgs e)
    {
        var result = await JS.InvokeAsync<ClickResult>(
            "mapHelper.getClickPercentage",
            await JS.InvokeAsync<IJSObjectReference>("eval", "document.getElementById('editor-map-inner')"),
            e.ClientX, e.ClientY);

        if (_movingPreset != null)
        {
            _movingPreset.X = Math.Round(result.X, 2);
            _movingPreset.Y = Math.Round(result.Y, 2);
            _movingPreset = null;
            RefreshJson();
        }
        else if (_placingPreset)
        {
            _pendingPresetX = result.X;
            _pendingPresetY = result.Y;
        }
        else
        {
            _pendingX = result.X;
            _pendingY = result.Y;
            _selectedPresetId = "";
        }
    }

    private void UpdateCharacterColor(CharacterModel character, string newColor)
    {
        character.Color = newColor;
        RefreshJson();
        StateHasChanged();
    }

    private void AddCharacter()
    {
        if (string.IsNullOrWhiteSpace(_newCharName)) return;
        _data.Characters.Add(new CharacterModel
        {
            Id = Guid.NewGuid().ToString(),
            Name = _newCharName.Trim(),
            Color = _newCharColor
        });
        _newCharName = "";
        _newCharColor = "#3b82f6";
        RefreshJson();
    }

    private void AddChapter()
    {
        if (string.IsNullOrWhiteSpace(_newChapterName)) return;
        _data.Chapters.Add(new ChapterModel
        {
            Name = _newChapterName.Trim(),
            Page = _newChapterPage
        });
        _data.Chapters = _data.Chapters.OrderBy(c => c.Page).ToList();
        _newChapterName = "";
        RefreshJson();
    }

    private void AddPreset()
    {
        if (!CanAddPreset) return;
        _data.Locations.Add(new LocationPreset
        {
            Id = Guid.NewGuid().ToString(),
            Name = _newPresetName.Trim(),
            X = Math.Round(_pendingPresetX!.Value, 2),
            Y = Math.Round(_pendingPresetY!.Value, 2)
        });
        _data.Locations = _data.Locations.OrderBy(p => p.Name).ToList();
        _newPresetName = "";
        _pendingPresetX = null;
        _pendingPresetY = null;
        _placingPreset = false;
        RefreshJson();
    }

    private void AddEntry()
    {
        if (!CanAddEntry) return;
        _data.Entries.Add(new MapEntry
        {
            CharacterId = _formCharacterId,
            Page = _formPage,
            Progress = Math.Round(_formPage / _data.TotalPages, 4),
            Location = _formLocation.Trim(),
            X = Math.Round(_pendingX!.Value, 2),
            Y = Math.Round(_pendingY!.Value, 2),
            Note = _formNote.Trim(),
            IsInvisible = _formIsInvisible
        });
        _data.Entries = _data.Entries.OrderBy(e => e.CharacterId).ThenBy(e => e.Page).ToList();
        _pendingX = null;
        _pendingY = null;
        _formLocation = "";
        _formNote = "";
        _formIsInvisible = false;
        _selectedPresetId = "";
        RefreshJson();
    }

    private void DeleteSelected()
    {
        if (_selectedEntry == null) return;
        _data.Entries.Remove(_selectedEntry);
        _selectedEntry = null;
        RefreshJson();
        StateHasChanged();
    }

    private void SelectEntry(MapEntry entry)
    {
        _selectedEntry = _selectedEntry == entry ? null : entry;
        if (_selectedEntry != null)
        {
            _formCharacterId = entry.CharacterId;
            _formPage = entry.Page;
            _formLocation = entry.Location;
            _formNote = entry.Note;
            _formIsInvisible = entry.IsInvisible;
        }
    }

    private void RefreshJson()
    {
        _json = JsonSerializer.Serialize(_data, new JsonSerializerOptions { WriteIndented = true });
    }

    private async Task CopyJson()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _json);
    }

    private record ClickResult(double X, double Y);
}
