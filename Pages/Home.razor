@page "/"
@inject HttpClient Http
@using ev.Models

<MudPaper Elevation="2" Class="pa-4 mb-2">
    @if (_data.Chapters.Any())
    {
        var chapters = _data.Chapters.OrderBy(c => c.Number).ToList();
        <MudSlider T="int" Min="1" Max="@(chapters.Count + 1)" Step="1"
                   @bind-Value="_chapterIndex"
                   Color="Color.Primary"
                   TickMarks="true"
                   TickMarkLabels="@chapters.Select(c => $"Ch.{c.Number} {c.Name}").Append("End").ToArray()" />
    }
    else
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No chapters loaded yet.</MudText>
    }
</MudPaper>

<MudPaper Elevation="2" Class="pa-4 mb-2">
    <MudGrid>
        <MudItem xs="4">
            <MudSelect T="int" Label="Current Chapter" @bind-Value="_chapterIndex"
                       Variant="Variant.Outlined">
                @foreach (var chapter in _data.Chapters.OrderBy(c => c.Number))
                {
                    var index = _data.Chapters.OrderBy(c => c.Number).ToList().IndexOf(chapter) + 1;
                    <MudSelectItem T="int" Value="@index">
                        Ch. @chapter.Number — @chapter.Name
                    </MudSelectItem>
                }
                <MudSelectItem T="int" Value="@(_data.Chapters.Count + 1)">End</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="4">
            <MudTextField Label="Character"
                          Value="@(_hoveredEntry != null ? GetCharacter(_hoveredEntry.CharacterId)?.Name : "")"
                          Placeholder="Hover over a marker..."
                          Variant="Variant.Outlined"
                          ReadOnly="true" />
        </MudItem>
        <MudItem xs="4">
            <MudTextField Label="Location"
                          Value="@(_hoveredEntry != null ? _hoveredEntry.Location : "")"
                          Placeholder="Hover over a marker..."
                          Variant="Variant.Outlined"
                          ReadOnly="true" />
        </MudItem>
    </MudGrid>

    @if (_data.Characters.Any())
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Character Colors</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
            @foreach (var character in _data.Characters)
            {
                var captured = character;
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mr-4">
                    <input type="color" value="@character.Color"
                           style="width:28px; height:28px; border:none; cursor:pointer; border-radius:4px;"
                           @onchange="e => UpdateColor(captured, e.Value?.ToString() ?? captured.Color)" />
                    <MudText Typo="Typo.body2">@character.Name</MudText>
                </MudStack>
            }
        </MudStack>
    }
</MudPaper>

<MudPaper Elevation="2" Class="pa-2 mb-4">
    <div style="position: relative; display: inline-block; width: 100%;">

        <MudImage Src="Images/Maps/inheritance_original_map.jpg"
                  Fluid="true" ObjectFit="ObjectFit.Contain" Alt="Map" />

        <svg style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none;">
            @foreach (var character in _data.Characters)
            {
                var trail = GetTrail(character.Id);
                if (trail.Count < 2) continue;
                for (int i = 0; i < trail.Count - 1; i++)
                {
                    var a = trail[i];
                    var b = trail[i + 1];
                    var lineOpacity = GetOpacity(i + 1, trail.Count);
                    <line x1="@($"{a.X:F2}%")" y1="@($"{a.Y:F2}%")"
                          x2="@($"{b.X:F2}%")" y2="@($"{b.Y:F2}%")"
                          stroke="@character.Color"
                          stroke-width="2"
                          stroke-dasharray="6 3"
                          stroke-opacity="@lineOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                }
            }
        </svg>

        @foreach (var character in _data.Characters)
        {
            var trail = GetTrail(character.Id);
            for (int i = 1; i < trail.Count; i++)
            {
                var entry = trail[i];
                if (entry.IsInvisible) continue;
                var opacity = GetOpacity(i, trail.Count);
                <MudIconButton Icon="@Icons.Material.Filled.Place"
                               Style="@($"position:absolute; left:{entry.X:F2}%; top:{entry.Y:F2}%; transform:translate(-50%,-100%); padding:0; color:{character.Color}; opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}; pointer-events:none;")" />
            }
        }

        @foreach (var character in _data.Characters)
        {
            var trail = GetTrail(character.Id);
            if (!trail.Any()) continue;
            var current = trail[0];
            if (current.IsInvisible) continue;
            var capturedEntry = current;
            <MudIconButton Icon="@Icons.Material.Filled.Place"
                           Style="@($"position:absolute; left:{current.X:F2}%; top:{current.Y:F2}%; transform:translate(-50%,-100%); padding:0; color:{character.Color};")"
                           @onmouseenter="() => _hoveredEntry = capturedEntry"
                           @onmouseleave="() => _hoveredEntry = null" />
        }

    </div>
</MudPaper>

<MudPaper Elevation="2" Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-3">Character Trails</MudText>
    <MudGrid>

        <MudItem xs="12" sm="6" md="2">
            <MudText Typo="Typo.subtitle2" Class="mb-1">Chapters</MudText>
            <MudTimeline TimelinePosition="TimelinePosition.Start">
                @if (IsEnd)
                {
                    <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                        <ItemContent>
                            <MudText Typo="Typo.body2"><strong>End</strong></MudText>
                            <MudText Typo="Typo.caption">All entries shown</MudText>
                        </ItemContent>
                    </MudTimelineItem>
                }
                @foreach (var chapter in PastChapters)
                {
                    var isCurrent = !IsEnd && chapter == SelectedChapter;
                    <MudTimelineItem Color="@(isCurrent? Color.Primary: Color.Default)" Size="Size.Small"
                                     Style="@($"opacity:{(isCurrent ? "1.0" : "0.5")}")">
                        <ItemContent>
                            <MudText Typo="Typo.body2"><strong>Ch. @chapter.Number</strong></MudText>
                            <MudText Typo="Typo.caption">@chapter.Name</MudText>
                            <MudText Typo="Typo.caption">p.@chapter.Page</MudText>
                        </ItemContent>
                    </MudTimelineItem>
                }
            </MudTimeline>
        </MudItem>

        @foreach (var character in _data.Characters)
        {
            var trail = GetTrail(character.Id).Where(e => !e.IsInvisible).ToList();
            if (!trail.Any()) continue;

            <MudItem xs="12" sm="6" md="2">
                <MudText Typo="Typo.subtitle2" Style="@($"color:{character.Color}")" Class="mb-1">
                    @character.Name
                </MudText>
                <MudTimeline TimelinePosition="TimelinePosition.Start">
                    @{
                        ChapterModel? lastChapterShown = null;
                        for (int i = 0; i < trail.Count; i++)
                        {
                            var entry = trail[i];
                            var entryOpacity = GetOpacity(i, trail.Count);
                            var entryChapter = _data.Chapters
                            .Where(ch => ch.Page <= entry.Page)
                            .OrderByDescending(ch => ch.Page)
                            .FirstOrDefault();

                            if (entryChapter != null && entryChapter != lastChapterShown)
                            {
                                lastChapterShown = entryChapter;
                                <MudTimelineItem Color="Color.Default" Size="Size.Small" Style="opacity:0.5">
                                    <ItemContent>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            ── Ch. @entryChapter.Number: @entryChapter.Name ──
                                        </MudText>
                                    </ItemContent>
                                </MudTimelineItem>
                            }

                            <MudTimelineItem Color="Color.Default" Size="Size.Small"
                                             Style="@($"opacity:{entryOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}")">
                                <ItemContent>
                                    <MudText Typo="Typo.body2"><strong>@entry.Location</strong></MudText>
                                    <MudText Typo="Typo.caption">p.@entry.Page</MudText>
                                    @if (!string.IsNullOrEmpty(entry.Note))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Note</MudText>
                                    }
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    }
                </MudTimeline>
            </MudItem>
        }

    </MudGrid>
</MudPaper>

@code {
    private MapData _data = new();
    private int _chapterIndex = 1;
    private MapEntry? _hoveredEntry;

    private bool IsEnd => _chapterIndex > _data.Chapters.Count;

    private ChapterModel? SelectedChapter =>
        _data.Chapters.Any()
            ? _data.Chapters.OrderBy(c => c.Number).ElementAtOrDefault(_chapterIndex - 1)
            : null;

    private List<ChapterModel> PastChapters =>
        _data.Chapters.OrderByDescending(c => c.Page).ToList();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<MapData>("data/mapdata.json") ?? new();
        }
        catch { _data = new(); }
    }

    private CharacterModel? GetCharacter(string id) =>
        _data.Characters.FirstOrDefault(c => c.Id == id);

    private void UpdateColor(CharacterModel character, string newColor)
    {
        character.Color = newColor;
        StateHasChanged();
    }

    private List<MapEntry> GetTrail(string characterId)
    {
        if (!_data.Chapters.Any()) return new();
        return _data.Entries
            .Where(e => e.CharacterId == characterId &&
                        (IsEnd || e.Page < SelectedChapter!.Page))
            .OrderByDescending(e => e.Page)
            .Take(5)
            .ToList();
    }

    private double GetOpacity(int index, int total)
    {
        double[] opacities = { 1.0, 0.75, 0.50, 0.30, 0.15 };
        return index < opacities.Length ? opacities[index] : 0.15;
    }
}
