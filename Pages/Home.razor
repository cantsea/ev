@page "/"

<MudPaper Elevation="0" Class="pa-4">
    <MudText Typo="Typo.h5" Class="mb-4">Map Timeline</MudText>

    <div style="position: relative; display: inline-block; width: 100%;">
        <MudImage Src="Images/Maps/inheritance_original_map.jpg"
                  ObjectFit="ObjectFit.Contain"
                  Fluid="true"
                  Alt="Map" />

        <MudTooltip Text="Test Location">
            <MudIconButton Icon="@Icons.Material.Filled.Place"
                           Color="Color.Error"
                           Style="position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); padding: 0;" />
        </MudTooltip>
    </div>
</MudPaper>