@inject HttpClient Http
@inject IJSRuntime JS
@using ev.Models

<div style="@($"--mud-palette-primary:{PrimaryColor}; --mud-palette-primary-text:white;")">

    <MudPaper Elevation="2" Class="pa-4 mb-2">
        @if (_data.Chapters.Any())
        {
            var chapters = _data.Chapters.OrderBy(c => c.Page).ToList();
            <div class="d-none d-md-block">
                <MudSlider T="int" Min="1" Max="@(chapters.Count + 1)" Step="1"
                           @bind-Value="_chapterIndex"
                           Color="Color.Primary"
                           TickMarks="true" />
            </div>
            <div class="d-md-none">
                <MudSlider T="int" Min="1" Max="@(chapters.Count + 1)" Step="1"
                           @bind-Value="_chapterIndex"
                           Color="Color.Primary"
                           TickMarks="true" />
            </div>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Primary" Style="text-align:center;">No chapters loaded yet.</MudText>
        }
    </MudPaper>

    <MudGrid Class="mb-4">

        <MudItem xs="12" md="3">
            <MudPaper Elevation="2" Class="pa-4" Style="height:100%;">

                <MudText Typo="Typo.h6" Class="mb-2" Style="text-align:center;">Current Chapter</MudText>
                <MudSelect T="int" @bind-Value="_chapterIndex" Variant="Variant.Outlined" Class="mb-4">
                    @foreach (var chapter in _data.Chapters.OrderBy(c => c.Page))
                    {
                        var index = _data.Chapters.OrderBy(c => c.Page).ToList().IndexOf(chapter) + 1;
                        <MudSelectItem T="int" Value="@index">@chapter.Name</MudSelectItem>
                    }
                    <MudSelectItem T="int" Value="@(_data.Chapters.Count + 1)">End</MudSelectItem>
                </MudSelect>

                <MudDivider Class="mb-4" />

                <MudText Typo="Typo.h6" Class="mb-2" Style="text-align:center;">Characters</MudText>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:8px;">
                    @foreach (var character in _data.Characters)
                    {
                        var captured = character;
                        <div style="display:flex; align-items:center; justify-content:center; gap:6px;">
                            <input type="color" value="@character.Color"
                                   style="width:22px; height:22px; border:none; cursor:pointer; border-radius:4px; flex-shrink:0;"
                                   @onchange="e => UpdateColor(captured, e.Value?.ToString() ?? captured.Color)" />
                            <MudText Typo="Typo.body2" Style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@character.Name</MudText>
                        </div>
                    }
                </div>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.h6" Class="mb-2" Style="text-align:center;">
                    @if (ActivePreset != null)
                    {
                        <span>📍 @ActivePreset.Name</span>
                    }
                    else if (ActiveEntry != null)
                    {
                        <span>@(GetCharacter(ActiveEntry.CharacterId)?.Name)</span>
                    }
                    else
                    {
                        <span>Selection</span>
                    }
                </MudText>

                <div style="overflow-x:auto;">
                    <MudTable Items="InfoRows" Dense="true" Hover="true" T="InfoRow" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="text-align:center;">Character</MudTh>
                            <MudTh Style="text-align:center;">Location</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Style="text-align:center;">
                                <div style="display:flex; justify-content:center; align-items:center; gap:4px;">
                                    <div style="width:10px; height:10px; border-radius:50%; background:@context.Color; flex-shrink:0;"></div>
                                    <MudText Typo="Typo.body2">@context.CharacterName</MudText>
                                </div>
                            </MudTd>
                            <MudTd Style="text-align:center;">@context.Location</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>

                @if (ActiveEntry != null || ActivePreset != null)
                {
                    <div style="text-align:center;">
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-2" OnClick="Deselect">
                            Deselect
                        </MudButton>
                    </div>
                }

            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="9">
            <MudPaper Elevation="2" Class="pa-2">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2 px-2">
                    <MudText Typo="Typo.caption" Color="Color.Primary">Scroll to zoom · Drag to pan · Click a marker to select</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Size="Size.Small" OnClick="ZoomIn" />
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Size="Size.Small" OnClick="ZoomOut" />
                    <MudIconButton Icon="@Icons.Material.Filled.CenterFocusStrong" Size="Size.Small" OnClick="ResetZoom" />
                </MudStack>

                <div id="@_mapWrapperId" style="overflow: hidden; width: 100%; touch-action: none;">
                    <div id="@_mapInnerId" style="position:relative; display:inline-block; width:100%;">

                        <MudImage Src="Images/Maps/inheritance_original_map.jpg"
                                  Fluid="true" ObjectFit="ObjectFit.Contain" Alt="Map" />

                        <svg style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none;">
                            @foreach (var character in _data.Characters)
                            {
                                var trail = GetTrail(character.Id);
                                if (trail.Count < 2) continue;
                                for (int i = 0; i < trail.Count - 1; i++)
                                {
                                    var a = trail[i];
                                    var b = trail[i + 1];
                                    var lineOpacity = GetOpacity(i + 1, trail.Count);
                                    <line x1="@($"{a.X:F2}%")" y1="@($"{a.Y:F2}%")"
                                          x2="@($"{b.X:F2}%")" y2="@($"{b.Y:F2}%")"
                                          stroke="@character.Color"
                                          stroke-width="2"
                                          stroke-dasharray="6 3"
                                          stroke-opacity="@lineOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)" />
                                }
                            }
                        </svg>

                        @foreach (var character in _data.Characters)
                        {
                            var trail = GetTrail(character.Id);
                            for (int i = 1; i < trail.Count; i++)
                            {
                                var entry = trail[i];
                                if (entry.IsInvisible) continue;
                                var opacity = GetOpacity(i, trail.Count);
                                <MudIconButton Icon="@Icons.Material.Filled.Place"
                                               Style="@($"position:absolute; left:{entry.X:F2}%; top:{entry.Y:F2}%; transform:translate(-50%,-100%); padding:0; color:{character.Color}; opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}; pointer-events:none;")" />
                            }
                        }

                        @foreach (var character in _data.Characters)
                        {
                            var trail = GetTrail(character.Id);
                            if (!trail.Any()) continue;
                            var current = trail[0];
                            if (current.IsInvisible) continue;
                            if (_data.Locations.Any(p => Math.Abs(p.X - current.X) < 0.01 && Math.Abs(p.Y - current.Y) < 0.01)) continue;
                            var capturedEntry = current;
                            var capturedChar = character;
                            var isSelected = _selectedEntry == capturedEntry;
                            <MudIconButton Icon="@Icons.Material.Filled.Place"
                                           Style="@($"position:absolute; left:{current.X:F2}%; top:{current.Y:F2}%; transform:translate(-50%,-100%); padding:0; color:{character.Color}; filter:{(isSelected ? "drop-shadow(0 0 4px white)" : "none")};")"
                                           @onmouseenter="() => { if (_selectedEntry == null && _selectedPreset == null) { _hoveredEntry = capturedEntry; _hoveredPreset = null; } }"
                                           @onmouseleave="() => { if (_selectedEntry == null && _selectedPreset == null) _hoveredEntry = null; }"
                                           @onclick="() => SelectEntry(capturedEntry, capturedChar)" />
                        }

                        @foreach (var preset in _data.Locations)
                        {
                            var capturedPreset = preset;
                            var charsHere = GetCharactersAtPreset(preset);
                            var isSelected = _selectedPreset == preset;
                            <MudIconButton Icon="@(charsHere.Any() ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)"
                                           Style="@($"position:absolute; left:{preset.X:F2}%; top:{preset.Y:F2}%; transform:translate(-50%,-50%); padding:0; color:#f59e0b; opacity:{(isSelected ? "1.0" : "0.6")}; filter:{(isSelected ? "drop-shadow(0 0 4px white)" : "none")};")"
                                           @onmouseenter="() => { if (_selectedEntry == null && _selectedPreset == null) { _hoveredPreset = capturedPreset; _hoveredEntry = null; } }"
                                           @onmouseleave="() => { if (_selectedEntry == null && _selectedPreset == null) _hoveredPreset = null; }"
                                           @onclick="() => SelectPreset(capturedPreset)" />
                        }

                    </div>
                </div>
            </MudPaper>
        </MudItem>

    </MudGrid>

    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-3" Style="text-align:center;">Character Trails</MudText>
        <div style="overflow-x:auto;">
            <MudGrid Style="flex-wrap:nowrap; min-width:max-content;">

                <MudItem xs="12" sm="6" md="2">
                    <MudText Typo="Typo.subtitle2" Class="mb-1" Style="text-align:center;">📖 Book Progress</MudText>
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        @if (IsEnd)
                        {
                            <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Style="text-align:center;"><strong>End</strong></MudText>
                                    <MudText Typo="Typo.caption" Style="text-align:center;">All entries shown</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                        @foreach (var chapter in PastChapters)
                        {
                            var isCurrent = !IsEnd && chapter == SelectedChapter;
                            <MudTimelineItem Color="@(isCurrent? Color.Primary: Color.Default)" Size="Size.Small"
                                             Style="@($"opacity:{(isCurrent ? "1.0" : "0.5")}")">
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Style="text-align:center;"><strong>@chapter.Name</strong></MudText>
                                    <MudText Typo="Typo.caption" Style="text-align:center;">p.@chapter.Page</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </MudItem>

                @foreach (var character in _data.Characters)
                {
                    var trail = GetTrail(character.Id).Where(e => !e.IsInvisible).ToList();
                    if (!trail.Any()) continue;

                    <MudItem xs="12" sm="6" md="2">
                        <MudText Typo="Typo.subtitle2" Style="@($"color:{character.Color}; text-align:center;")" Class="mb-1">
                            @character.Name
                        </MudText>
                        <MudTimeline TimelinePosition="TimelinePosition.Start">
                            @{
                                ChapterModel? lastChapterShown = null;
                                for (int i = 0; i < trail.Count; i++)
                                {
                                    var entry = trail[i];
                                    var entryOpacity = GetOpacity(i, trail.Count);
                                    var entryChapter = _data.Chapters
                                    .Where(ch => ch.Page <= entry.Page)
                                    .OrderByDescending(ch => ch.Page)
                                    .FirstOrDefault();

                                    if (entryChapter != null && entryChapter != lastChapterShown)
                                    {
                                        lastChapterShown = entryChapter;
                                        <MudTimelineItem Color="Color.Default" Size="Size.Small" Style="opacity:0.5">
                                            <ItemContent>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-align:center;">
                                                    ── @entryChapter.Name ──
                                                </MudText>
                                            </ItemContent>
                                        </MudTimelineItem>
                                    }

                                    <MudTimelineItem Color="Color.Default" Size="Size.Small"
                                                     Style="@($"opacity:{entryOpacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}")">
                                        <ItemContent>
                                            <MudText Typo="Typo.body2" Style="text-align:center;"><strong>@entry.Location</strong></MudText>
                                            <MudText Typo="Typo.caption" Style="text-align:center;">p.@entry.Page</MudText>
                                            @if (!string.IsNullOrEmpty(entry.Note))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-align:center;">@entry.Note</MudText>
                                            }
                                        </ItemContent>
                                    </MudTimelineItem>
                                }
                            }
                        </MudTimeline>
                    </MudItem>
                }

            </MudGrid>
        </div>
    </MudPaper>

</div>

@code {
    [Parameter] public string DataFile { get; set; } = "";
    [Parameter] public string PrimaryColor { get; set; } = "#6750A4";

    // Each instance gets unique IDs so multiple maps on the same page won't conflict
    private string _mapWrapperId = Guid.NewGuid().ToString("N");
    private string _mapInnerId = Guid.NewGuid().ToString("N");

    private MapData _data = new();
    private int _chapterIndex = 1;

    private MapEntry? _hoveredEntry;
    private LocationPreset? _hoveredPreset;
    private MapEntry? _selectedEntry;
    private LocationPreset? _selectedPreset;

    private MapEntry? ActiveEntry => _selectedEntry ?? _hoveredEntry;
    private LocationPreset? ActivePreset => _selectedPreset ?? _hoveredPreset;

    private record InfoRow(string CharacterName, string Color, string Location);

    private List<InfoRow> InfoRows
    {
        get
        {
            if (ActivePreset != null)
            {
                return GetCharactersAtPreset(ActivePreset)
                    .Select(c =>
                    {
                        var trail = GetTrail(c.Id);
                        var loc = trail.FirstOrDefault(e => !e.IsInvisible)?.Location ?? "";
                        return new InfoRow(c.Name, c.Color, loc);
                    })
                    .ToList();
            }
            if (ActiveEntry != null)
            {
                var c = GetCharacter(ActiveEntry.CharacterId);
                if (c != null)
                    return new List<InfoRow> { new InfoRow(c.Name, c.Color, ActiveEntry.Location) };
            }
            return new();
        }
    }

    private bool IsEnd => _chapterIndex > _data.Chapters.Count;

    private ChapterModel? SelectedChapter =>
        _data.Chapters.Any()
            ? _data.Chapters.OrderBy(c => c.Page).ElementAtOrDefault(_chapterIndex - 1)
            : null;

    private List<ChapterModel> PastChapters =>
        _data.Chapters.OrderByDescending(c => c.Page).ToList();

    private List<CharacterModel> GetCharactersAtPreset(LocationPreset preset)
    {
        var result = new List<CharacterModel>();
        foreach (var character in _data.Characters)
        {
            var trail = GetTrail(character.Id);
            if (!trail.Any()) continue;
            var current = trail[0];
            if (current.IsInvisible) continue;
            if (Math.Abs(current.X - preset.X) < 0.01 && Math.Abs(current.Y - preset.Y) < 0.01)
                result.Add(character);
        }
        return result;
    }

    private void SelectEntry(MapEntry entry, CharacterModel character)
    {
        if (_selectedEntry == entry) { Deselect(); return; }
        _selectedEntry = entry;
        _selectedPreset = null;
        _hoveredEntry = null;
        _hoveredPreset = null;
    }

    private void SelectPreset(LocationPreset preset)
    {
        if (_selectedPreset == preset) { Deselect(); return; }
        _selectedPreset = preset;
        _selectedEntry = null;
        _hoveredEntry = null;
        _hoveredPreset = null;
    }

    private void Deselect()
    {
        _selectedEntry = null;
        _selectedPreset = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Http.GetFromJsonAsync<MapData>($"{DataFile}?v={DateTime.UtcNow.Ticks}") ?? new();
        }
        catch { _data = new(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("mapHelper.initPanzoom", _mapWrapperId, _mapInnerId);
    }

    private async Task ResetZoom() =>
        await JS.InvokeVoidAsync("mapHelper.resetZoom", _mapWrapperId);

    private async Task ZoomIn() =>
        await JS.InvokeVoidAsync("eval", $"mapHelper.panzoomInstances['{_mapWrapperId}']?.zoomIn()");

    private async Task ZoomOut() =>
        await JS.InvokeVoidAsync("eval", $"mapHelper.panzoomInstances['{_mapWrapperId}']?.zoomOut()");

    private CharacterModel? GetCharacter(string id) =>
        _data.Characters.FirstOrDefault(c => c.Id == id);

    private void UpdateColor(CharacterModel character, string newColor)
    {
        character.Color = newColor;
        StateHasChanged();
    }

    private List<MapEntry> GetTrail(string characterId)
    {
        return _data.Entries
            .Where(e => e.CharacterId == characterId &&
                        (!_data.Chapters.Any() || IsEnd || e.Page < SelectedChapter!.Page))
            .OrderByDescending(e => e.Page)
            .Take(5)
            .ToList();
    }

    private double GetOpacity(int index, int total)
    {
        double[] opacities = { 1.0, 0.75, 0.50, 0.30, 0.15 };
        return index < opacities.Length ? opacities[index] : 0.15;
    }
}

