@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_darkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="() => _drawerOpen = !_drawerOpen" />
        <MudText Typo="Typo.h6" Class="ml-2">@_pageTitle</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(_darkMode? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit"
                       OnClick="ToggleDarkMode" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">ev</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map">
                Home
            </MudNavLink>
            <MudNavLink Href="/Maps/Eragon" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map">
                Eragon Map
            </MudNavLink>
            <MudNavLink Href="/Maps/Eldest" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map">
                Eldest Map
            </MudNavLink>
            <MudNavLink Href="/Maps/Brisingr" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map">
                Brisingr Map
            </MudNavLink>
            <MudNavLink Href="/Maps/Inheritance" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Map">
                Inheritance Map
            </MudNavLink>
            <MudNavLink Href="editor" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Edit">
                Editor
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _darkMode = true;
    private string _pageTitle = "Map";
    private MudTheme _theme = new();

    private static readonly Dictionary<string, string> _pageTitles = new()
    {
        { "", "Map" },
        { "editor", "Editor" },
    };

    protected override void OnInitialized()
    {
        UpdateTitle(Nav.Uri);
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateTitle(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdateTitle(string uri)
    {
        var segment = new Uri(uri).AbsolutePath.Trim('/').ToLower();
        _pageTitle = _pageTitles.TryGetValue(segment, out var title) ? title : segment;
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedDark = await JS.InvokeAsync<string?>("localStorage.getItem", "ev_darkmode");
            _darkMode = savedDark == null ? true : savedDark == "true";
            RebuildTheme();
            StateHasChanged();
        }
    }

    private async Task ToggleDarkMode()
    {
        _darkMode = !_darkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "ev_darkmode", _darkMode.ToString().ToLower());
    }

    private void RebuildTheme()
    {
        _theme = new MudTheme
        {
            PaletteLight = new PaletteLight
            {
                Primary = "#6750A4",
                Background = "#FFFFFF",
                Surface = "#F5F5F5",
                DrawerBackground = "#F5F5F5",
                AppbarBackground = "#F5F5F5",
                AppbarText = "#424242",
            },
            PaletteDark = new PaletteDark
            {
                Primary = "#6750A4",
                Background = "#121212",
                Surface = "#1E1E1E",
                DrawerBackground = "#1E1E1E",
                AppbarBackground = "#1E1E1E",
            }
        };
    }
}
